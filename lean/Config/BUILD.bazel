load("@rules_lean//lean:defs.bzl", "lean_library", "lean_test")

package(default_visibility = ["//visibility:public"])

lean_library(
    name = "config",
    srcs = ["Config.lean"],
    strip_module_prefix = "lean",
)

lean_test(
    name = "config_test",
    size = "small",
    srcs = ["ConfigTest.lean"],
    env = {
        "BROKEN_BACKUP_PORT": "-1",
        "BROKEN_COUNT": "many",
        "BROKEN_ENABLED": "perhaps",
        "CUSTOM_LABELS": "api, worker, ,scheduler",
        "CUSTOM_LOG_LEVEL": "warn",
        "FOOBAR_QUX": "from-environment",
        "NESTED_DATABASE_HOST": "db.internal",
        "NESTED_WORKERS": "6",
        "OVERRIDE_BAZ": " 21 ",
        "OVERRIDE_MAX_RETRIES": "0",
        "OVERRIDE_QUX": "overridden",
        "RICH_EMPTY": ", ,",
        "RICH_ENABLED": " YeS ",
        "RICH_FLAGS": "true, 0, ON, no",
        "RICH_NOTE": "  preserve whitespace  ",
        "RICH_OFFSET": " -42 ",
        "RICH_PORTS": "80, 443, ,8080",
        "RICH_STATE_DIR": "/var/lib/acme widgets",
    },
    strip_module_prefix = "lean",
    deps = [":config"],
)
