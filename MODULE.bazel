# lean-acme-widgets/MODULE.bazel
"""Example Lean 4 software system: the "Acme Widgets" service.

Ties together the Lean service ecosystem end to end — rules_lean (build),
rules_lean_grpc (proto/gRPC codegen + runtime), http2-lean (HTTP/2, HPACK,
and h2c/TLS transport), protovalidate_lean (CEL refinement-type codegen +
runtime), lean-pgx (checked PostgreSQL codegen), pg-lean (PostgreSQL client),
tls13-lean (TLS 1.3), and lentil (dependency injection + environment
configuration) — into one deployable service.

This module is always the root of its own build. Siblings under active
co-development are wired with local_path_override; published foundations are
consumed from immutable archives. Transitive overrides are ignored by Bzlmod
when a module is not root, so this root re-declares every required override.
"""

module(
    name = "lean-acme-widgets",
    version = "0.1.0",
    compatibility_level = 1,
)

# ── base Lean build rules ───────────────────────────────────────────────────
bazel_dep(name = "rules_lean", version = "0.1.0")
local_path_override(
    module_name = "rules_lean",
    path = "../rules_lean",
)

# ── dependency injection + environment configuration ────────────────────────
# The lifecycle contract is pinned independently of sibling development.
bazel_dep(name = "lentil", version = "0.1.0")
archive_override(
    module_name = "lentil",
    integrity = "sha256-lgaK6uRWDdEl+pDRmV92dBeAJD/0mYDbaqT/5lY7dgA=",
    strip_prefix = "lentil-5b3fe632ba17fde042890149dc1e674fb5f5731c",
    urls = [
        "https://github.com/pb64-lean/lentil/archive/5b3fe632ba17fde042890149dc1e674fb5f5731c.tar.gz",
    ],
)

# ── proto/gRPC codegen rules and pure-Lean gRPC runtime ─────────────────────
bazel_dep(name = "rules_lean_grpc", version = "0.1.0")
local_path_override(
    module_name = "rules_lean_grpc",
    path = "../grpc-lean",
)

# grpc-lean's generic RFC foundation. The root repeats the immutable commit
# override because Bzlmod intentionally ignores dependency-owned overrides.
bazel_dep(name = "http2-lean", version = "0.1.0", repo_name = "http2_lean")
archive_override(
    module_name = "http2-lean",
    integrity = "sha256-JkQPBLVdgICr3ZWYejr6iDQ1aYHHYS5VEFK9IOkgGeY=",
    strip_prefix = "http2-lean-4dfaa5686ccdc3e90251d7146496a9708d2752d1",
    urls = [
        "https://github.com/pb64-lean/http2-lean/archive/4dfaa5686ccdc3e90251d7146496a9708d2752d1.tar.gz",
    ],
)

bazel_dep(name = "grpc_lean_protobuf", version = "0.1.0")
local_path_override(
    module_name = "grpc_lean_protobuf",
    path = "../grpc-lean/third_party/Lean-zh/protobuf",
)

bazel_dep(name = "grpc_lean_protobuf_binary", version = "0.1.0")
local_path_override(
    module_name = "grpc_lean_protobuf_binary",
    path = "../grpc-lean/third_party/Lean-zh/binary",
)

# ── protovalidate: CEL annotations → Lean refinement types ──────────────────
bazel_dep(name = "protovalidate_lean", version = "0.1.0")
local_path_override(
    module_name = "protovalidate_lean",
    path = "../protovalidate-lean",
)

# ── PostgreSQL client ───────────────────────────────────────────────────────
bazel_dep(name = "pg-lean", version = "0.1.0", repo_name = "pg_lean")
local_path_override(
    module_name = "pg-lean",
    path = "../pg-lean",
)

# Checked PostgreSQL schema/query generation.
bazel_dep(name = "lean-pgx", version = "0.1.0")
local_path_override(
    module_name = "lean-pgx",
    path = "../lean-pgx",
)

# lean-pgx's generator macros refer to these execution-time tools from the
# consuming root repository. Reuse lean-pgx's pinned Nix expression while
# instantiating root-owned repositories under the names used by the macros.
bazel_dep(name = "rules_nixpkgs_core", version = "0.13.0")

lean_pgx_postgres_nix = use_extension(
    "@rules_nixpkgs_core//extensions:repository.bzl",
    "nix_repo",
)
lean_pgx_postgres_nix.file(
    name = "postgres_nixpkgs",
    file = "@lean-pgx//:postgres.nix",
    file_deps = ["@lean-pgx//:postgres.json"],
)
use_repo(lean_pgx_postgres_nix, "postgres_nixpkgs")

lean_pgx_postgres_pkg = use_extension(
    "@rules_nixpkgs_core//extensions:package.bzl",
    "nix_pkg",
)

_POSTGRES_BUILD = """\
filegroup(
    name = "toolchain",
    srcs = glob(["bin/**", "lib/**", "share/**"]),
    visibility = ["//visibility:public"],
)
"""

_SOCAT_BUILD = """\
filegroup(
    name = "toolchain",
    srcs = ["bin/socat", "bin/socat1"],
    visibility = ["//visibility:public"],
)
"""

_COREUTILS_BUILD = """\
filegroup(
    name = "toolchain",
    srcs = [
        "bin/coreutils",
        "bin/mkdir",
        "bin/mktemp",
        "bin/rm",
        "bin/sleep",
    ],
    visibility = ["//visibility:public"],
)
"""

lean_pgx_postgres_pkg.attr(
    name = "postgresql_17",
    attr = "postgresql_17",
    build_file_content = _POSTGRES_BUILD,
    repo = "@postgres_nixpkgs",
)
lean_pgx_postgres_pkg.attr(
    name = "postgresql_18",
    attr = "postgresql_18",
    build_file_content = _POSTGRES_BUILD,
    repo = "@postgres_nixpkgs",
)
lean_pgx_postgres_pkg.attr(
    name = "socat",
    attr = "socat",
    build_file_content = _SOCAT_BUILD,
    repo = "@postgres_nixpkgs",
)
lean_pgx_postgres_pkg.attr(
    name = "coreutils",
    attr = "coreutils",
    build_file_content = _COREUTILS_BUILD,
    repo = "@postgres_nixpkgs",
)
use_repo(
    lean_pgx_postgres_pkg,
    "coreutils",
    "postgresql_17",
    "postgresql_18",
    "socat",
)

# ── TLS 1.3 (used by pg-lean; also directly available) ──────────────────────
bazel_dep(name = "tls13-lean", version = "0.1.0", repo_name = "tls13_lean")
local_path_override(
    module_name = "tls13-lean",
    path = "../tls13-lean",
)

# ── proto ecosystem (shared with the codegen modules) ───────────────────────
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "protovalidate", version = "1.2.2")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

# Python load client. rules_python supplies a hermetic interpreter plus pinned
# wheels for both stub generation and the async gRPC runtime.
bazel_dep(name = "rules_python", version = "1.6.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "acme_pip",
    python_version = "3.12",
    requirements_lock = "//:requirements-load.txt",
)
use_repo(pip, "acme_pip")

# ── Lean toolchain (dev-only: not forced on consumers) ──────────────────────
# Reuses the pinned nixpkgs + lean overlay from grpc_lean_protobuf, matching
# every sibling workspace.
lean = use_extension("@rules_lean//lean:extensions.bzl", "lean", dev_dependency = True)
lean.nix_toolchain(
    name = "lean4",
    attr = "lean4_upstream_std",
    nix_file = "@grpc_lean_protobuf//:nixpkgs.nix",
    nix_file_deps = ["@grpc_lean_protobuf//:nixpkgs.json"],
)
use_repo(lean, "lean4_toolchain")

register_toolchains(
    "@lean4_toolchain//:all",
    dev_dependency = True,
)
