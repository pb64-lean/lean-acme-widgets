package(default_visibility = ["//visibility:public"])

load("@lean-pgx//bazel:defs.bzl", "pg_live_test")
load("@rules_lean//lean:defs.bzl", "lean_binary")

# In-process TLS end-to-end: Lean gRPC client → TLS → WidgetService → pg-lean.
# Run via scripts/acme-grpc-tls.sh (needs postgres + generated certs).
lean_binary(
    name = "grpc_tls_test",
    srcs = ["TlsClientTest.lean"],
    deps = [
        "//lean/Acme:service",
        "//proto:acme_lean",
        "@pg_lean//:pg_lean",
        "@rules_lean_grpc//:grpc_lean",
    ],
)

# Fresh-cluster acceptance for the canonical migration, generated contract,
# attachment, descriptor checks, cardinalities, and all five CRUD runners.
lean_binary(
    name = "lean_pgx_live_test_bin",
    srcs = ["LeanPgxLiveTest.lean"],
    deps = [
        "//db:acme_db",
        "@pg_lean//:pg_lean",
    ],
)

pg_live_test(
    name = "lean_pgx_live_test",
    database = "//db:acme_db",
    postgres = "@postgresql_18//:toolchain",
    runner = ":lean_pgx_live_test_bin",
)

pg_live_test(
    name = "lean_pgx_live_test_pg17",
    database = "//db:acme_db",
    major = 17,
    postgres = "@postgresql_17//:toolchain",
    runner = ":lean_pgx_live_test_bin",
)
