# Focused, opt-in page mapping benchmark. The row is validated once, outside
# the timed loop, then the proof-directed projection is compared with the
# former checked-Int mapping at page sizes 10 and 100.
lean_binary(
    name = "repo_mapping_benchmark",
    srcs = ["RepoMappingBenchmark.lean"],
    tags = ["manual"],
    deps = ["//lean/Acme:repo"],
)
