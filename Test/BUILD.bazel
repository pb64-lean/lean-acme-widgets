package(default_visibility = ["//visibility:public"])

load("@rules_lean//lean:defs.bzl", "lean_binary", "lean_test")

lean_test(
    name = "smoke_test",
    srcs = ["SmokeTest.lean"],
    deps = ["//lean:acme"],
)

lean_test(
    name = "acme_valid_test",
    srcs = ["AcmeValidTest.lean"],
    deps = [
        "//lean/Acme:auth",
        "//lean/Acme:repo",
        "//lean/Acme:service",
        "//proto:acme_valid",
        "@rules_lean_grpc//:grpc_lean",
