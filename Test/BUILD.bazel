package(default_visibility = ["//visibility:public"])

load("@rules_lean//lean:defs.bzl", "lean_binary", "lean_test")

lean_test(
    name = "lifecycle_test",
    srcs = ["LifecycleTest.lean"],
    deps = ["//lean/Acme:lifecycle"],
)

lean_test(
    name = "smoke_test",
    srcs = ["SmokeTest.lean"],
    deps = ["//lean:acme"],
)

lean_test(
    name = "acme_valid_test",
    srcs = ["AcmeValidTest.lean"],
    deps = [
        "//lean/Acme:auth",
        "//lean/Acme:repo",
        "//lean/Acme:service",
        "//proto:acme_valid",
        "@rules_lean_grpc//:grpc_lean",
    ],
)

# Exact semantic differential for the allocation-free bearer-suffix lookup,
# including last-header selection, malformed spacing, Unicode, embedded NUL,
# and boundary lengths.
lean_test(
    name = "auth_suffix_test",
    srcs = ["AuthSuffixTest.lean"],
    deps = ["//lean/Acme:auth"],
)

# DB-free vertical test of the generated protected-service registration:
# pre-body authentication, request validation, method CEL policy evaluation,
# authenticated Principal injection, and fail-closed raw dispatch.
lean_test(
    name = "authz_boundary_test",
    srcs = ["AuthzBoundaryTest.lean"],
    deps = [
        "//lean/Acme:auth",
        "//proto:acme_valid",
        "@rules_lean_grpc//:grpc_lean",
    ],
)

# Opt-in auth-only copied-vs-borrowed suffix instruction-counter harness.
lean_binary(
    name = "auth_suffix_benchmark",
    srcs = ["AuthSuffixBenchmark.lean"],
    tags = ["manual"],
    deps = ["//lean/Acme:auth"],
)

# Focused, opt-in page mapping benchmark. The row is validated once, outside
# the timed loop, then the proof-directed projection is compared with the
# former checked-Int mapping at page sizes 10 and 100.
lean_binary(
    name = "repo_mapping_benchmark",
    srcs = ["RepoMappingBenchmark.lean"],
    tags = ["manual"],
    deps = ["//lean/Acme:repo"],
)

# Opt-in counter harness for proof-bounded row-owned span decoding. It freezes
# the exact generated ListWidgets batch callback across matching and fallback
# format vectors at 0/1/55 rows.
lean_binary(
    name = "row_owned_span_benchmark",
    srcs = ["RowOwnedSpanBenchmark.lean"],
    tags = ["manual"],
    deps = [
        "//db:acme_db",
        "@pg_lean//Pg/Protocol:protocol",
    ],
)

lean_test(
    name = "row_owned_span_test",
    srcs = ["RowOwnedSpanBenchmark.lean"],
    args = ["batch_many", "mixed_1", "1", "0"],
    deps = [
        "//db:acme_db",
        "@pg_lean//Pg/Protocol:protocol",
    ],
)
