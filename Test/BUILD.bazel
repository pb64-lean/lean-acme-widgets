package(default_visibility = ["//visibility:public"])

load("@rules_lean//lean:defs.bzl", "lean_binary", "lean_test")

lean_test(
    name = "smoke_test",
    srcs = ["SmokeTest.lean"],
    deps = ["//lean:acme"],
)

lean_test(
    name = "acme_valid_test",
    srcs = ["AcmeValidTest.lean"],
    deps = [
        "//lean/Acme:auth",
        "//lean/Acme:repo",
        "//lean/Acme:service",
        "//proto:acme_valid",
        "@rules_lean_grpc//:grpc_lean",
    ],
)

# Focused, opt-in page mapping benchmark. The row is validated once, outside
# the timed loop, then the proof-directed projection is compared with the
# former checked-Int mapping at page sizes 10 and 100.
lean_binary(
    name = "repo_mapping_benchmark",
    srcs = ["RepoMappingBenchmark.lean"],
    tags = ["manual"],
    deps = ["//lean/Acme:repo"],
)

# Opt-in baseline for the row-owned PostgreSQL result-span experiment. It
# starts after framing, exercises production Backend DataRow decoding, grows
# the production result-array shape, and invokes ListWidgets' generated
# prepared decoder over fixed mixed-format and control batches.
lean_binary(
    name = "row_owned_span_benchmark",
    srcs = ["RowOwnedSpanBenchmark.lean"],
    tags = ["manual"],
    deps = [
        "//db:acme_db",
        "@pg_lean//Pg/Protocol:protocol",
    ],
)
