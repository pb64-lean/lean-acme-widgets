package(default_visibility = ["//visibility:public"])

load("@rules_lean//lean:defs.bzl", "lean_binary", "lean_test")

lean_test(
    name = "smoke_test",
    srcs = ["SmokeTest.lean"],
    deps = ["//lean:acme"],
)

lean_test(
    name = "acme_valid_test",
    srcs = ["AcmeValidTest.lean"],
    deps = [
        "//lean/Acme:auth",
        "//lean/Acme:repo",
        "//lean/Acme:service",
        "//proto:acme_valid",
        "@rules_lean_grpc//:grpc_lean",
    ],
)

# Exact semantic differential for the allocation-free bearer-suffix lookup,
# including last-header selection, malformed spacing, Unicode, embedded NUL,
# and boundary lengths.
lean_test(
    name = "auth_suffix_test",
    srcs = ["AuthSuffixTest.lean"],
    deps = ["//lean/Acme:auth"],
)

# No-Pg regression for the installed startup-bound request authorizer: all
# demo tokens × all WidgetService methods, exact auth failures/last-header
# behavior, and non-Widget passthrough against the former rebuild shape.
lean_test(
    name = "dispatch_cache_test",
    srcs = ["DispatchCacheTest.lean"],
    deps = ["//lean/Acme:service"],
)

# Opt-in auth-only copied-vs-borrowed suffix instruction-counter harness.
lean_binary(
    name = "auth_suffix_benchmark",
    srcs = ["AuthSuffixBenchmark.lean"],
    tags = ["manual"],
    deps = ["//lean/Acme:auth"],
)

# Opt-in no-Pg instruction-counter harness. `rebuild` retains the exact
# former per-request TokenTable.bind shape; `prebound` installs the same
# synthetic WidgetService registries once before the loop.
lean_binary(
    name = "dispatch_cache_benchmark",
    srcs = ["DispatchCacheBenchmark.lean"],
    tags = ["manual"],
    deps = ["//lean/Acme:service"],
)

# Focused, opt-in page mapping benchmark. The row is validated once, outside
# the timed loop, then the proof-directed projection is compared with the
# former checked-Int mapping at page sizes 10 and 100.
lean_binary(
    name = "repo_mapping_benchmark",
    srcs = ["RepoMappingBenchmark.lean"],
    tags = ["manual"],
    deps = ["//lean/Acme:repo"],
)

# Opt-in reference/candidate counter harness for proof-bounded row-owned span
# decoding. It starts after framing, grows the production result-array shape,
# and invokes the actual six-column ListWidgets prepared decoder.
lean_binary(
    name = "row_owned_span_benchmark",
    srcs = ["RowOwnedSpanBenchmark.lean"],
    tags = ["manual"],
    deps = [
        "//db:acme_db",
        "@pg_lean//Pg/Protocol:protocol",
    ],
)

lean_test(
    name = "row_owned_span_test",
    srcs = ["RowOwnedSpanBenchmark.lean"],
    args = ["candidate", "mixed_1", "1", "0"],
    deps = [
        "//db:acme_db",
        "@pg_lean//Pg/Protocol:protocol",
    ],
)
